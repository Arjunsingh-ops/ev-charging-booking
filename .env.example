# ==============================================================================
# CHARGECONNECT — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in the values for your deployment.

# MongoDB Database Connection
# Local: mongodb://localhost:27017/chargeconnect
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/chargeconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/chargeconnect
MONGODB_DB_NAME=chargeconnect

# JWT Authentication Secret Key
# Run `openssl rand -base64 32` to generate a secure secret key
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# Google Maps Platform API Key
# Obtain from Google Cloud Console with Maps JavaScript API enabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
